  "orderMatters": true,
  "referenceSql": "SELECT s.student_id FROM students s\nWHERE (SELECT AVG(e.GPA) FROM enrollments e WHERE e.student_id=s.student_id)>=2.5\nAND NOT EXISTS (\n SELECT 1 FROM courses c WHERE c.major=s.major AND LOWER(c.mandatory)='yes'\n AND (NOT EXISTS (SELECT 1 FROM enrollments e WHERE e.student_id=s.student_id AND e.course_id=c.course_id)\n OR EXISTS (SELECT 1 FROM enrollments e WHERE e.student_id=s.student_id AND e.course_id=c.course_id AND e.grade<>'A'))\n)\nAND (SELECT COUNT(DISTINCT c.course_id) FROM courses c JOIN enrollments e ON e.course_id=c.course_id\n WHERE e.student_id=s.student_id AND c.major=s.major AND LOWER(c.mandatory)='no')>=2\nAND NOT EXISTS (\n SELECT 1 FROM courses c JOIN enrollments e ON e.course_id=c.course_id\n WHERE e.student_id=s.student_id AND c.major=s.major AND LOWER(c.mandatory)='no' AND e.grade NOT IN ('A','B')\n) ORDER BY s.student_id",
