  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH RECURSIVE S AS (\n  SELECT\n    0 AS n\n  UNION\n  SELECT\n    n + 1\n  FROM S\n  WHERE\n    n < (\n      SELECT\n        MAX(cnt)\n      FROM (\n        SELECT\n          COUNT(1) AS cnt\n        FROM Transactions\n        GROUP BY\n          user_id,\n          transaction_date\n      ) AS t\n    )\n), T AS (\n  SELECT\n    v.user_id,\n    visit_date,\n    COALESCE(cnt, 0) AS cnt\n  FROM Visits AS v\n  LEFT JOIN (\n    SELECT\n      user_id,\n      transaction_date,\n      COUNT(1) AS cnt\n    FROM Transactions\n    GROUP BY\n      1,\n      2\n  ) AS t\n    ON v.user_id = t.user_id AND v.visit_date = t.transaction_date\n)\nSELECT\n  n AS transactions_count,\n  COUNT(user_id) AS visits_count\nFROM S AS s\nLEFT JOIN T AS t\n  ON s.n = t.cnt\nGROUP BY\n  n\nORDER BY\n  n",
