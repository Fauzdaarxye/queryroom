  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH top_students AS (\n  SELECT\n    user_id\n  FROM course_completions\n  GROUP BY\n    user_id\n  HAVING\n    COUNT(1) >= 5 AND AVG(course_rating) >= 4\n), course_pairs AS (\n  SELECT\n    course_name AS first_course,\n    LEAD(course_name) OVER (PARTITION BY user_id ORDER BY completion_date) AS second_course\n  FROM top_students\n  JOIN course_completions\n    USING (user_id)\n)\nSELECT\n  *,\n  COUNT(1) AS transition_count\nFROM course_pairs\nWHERE\n  NOT second_course IS NULL\nGROUP BY\n  1,\n  2\nORDER BY\n  3 DESC,\n  1,\n  2",
