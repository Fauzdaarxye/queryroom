  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH RECURSIVE T(task_id, subtask_id) AS (\n  SELECT\n    task_id,\n    subtasks_count\n  FROM Tasks\n  UNION ALL\n  SELECT\n    task_id,\n    subtask_id - 1\n  FROM t\n  WHERE\n    subtask_id > 1\n)\nSELECT\n  T.*\nFROM T\nLEFT JOIN Executed\n  USING (task_id, subtask_id)\nWHERE\n  Executed.subtask_id IS NULL",
