  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH t AS (\n  SELECT\n    *,\n    ROW_NUMBER() OVER (PARTITION BY company ORDER BY salary ASC, id ASC) AS rk,\n    COUNT(id) OVER (PARTITION BY company) AS n\n  FROM Employee\n)\nSELECT\n  id,\n  company,\n  salary\nFROM t\nWHERE\n  rk >= CAST(n AS REAL) / 2 AND rk <= CAST(n AS REAL) / 2 + 1",
