  "orderMatters": false,
  "referenceSql": "WITH s AS (\n SELECT employee_id, SUM(salary) OVER(ORDER BY salary,employee_id ROWS UNBOUNDED PRECEDING) AS cost\n FROM Candidates WHERE experience='Senior'\n), j AS (\n SELECT employee_id, SUM(salary) OVER(ORDER BY salary,employee_id ROWS UNBOUNDED PRECEDING)\n + COALESCE((SELECT MAX(cost) FROM s WHERE cost<=70000),0) AS cost\n FROM Candidates WHERE experience='Junior'\n) SELECT employee_id FROM s WHERE cost<=70000\nUNION ALL SELECT employee_id FROM j WHERE cost<=70000",
