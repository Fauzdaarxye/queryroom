  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    user1_id,\n    user2_id\n  FROM Friendship\n  UNION\n  SELECT\n    user2_id AS user1_id,\n    user1_id AS user2_id\n  FROM Friendship\n)\nSELECT DISTINCT\n  l1.user_id,\n  l2.user_id AS recommended_id\nFROM Listens AS l1, Listens AS l2\nWHERE\n  l1.day = l2.day\n  AND l1.song_id = l2.song_id\n  AND l1.user_id <> l2.user_id\n  AND NOT EXISTS(\n    SELECT\n      1\n    FROM T AS t\n    WHERE\n      l1.user_id = t.user1_id AND l2.user_id = t.user2_id\n  )\nGROUP BY\n  l1.day,\n  l1.user_id,\n  l2.user_id\nHAVING\n  COUNT(DISTINCT l1.song_id) >= 3",
