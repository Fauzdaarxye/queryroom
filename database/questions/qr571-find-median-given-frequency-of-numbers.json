  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH t AS (\n  SELECT\n    *,\n    SUM(frequency) OVER (ORDER BY num ASC) AS rk1,\n    SUM(frequency) OVER (ORDER BY num DESC) AS rk2,\n    SUM(frequency) OVER () AS s\n  FROM Numbers\n)\nSELECT\n  ROUND(AVG(num), 1) AS median\nFROM t\nWHERE\n  rk1 >= CAST(s AS REAL) / 2 AND rk2 >= CAST(s AS REAL) / 2",
