  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH user_category AS (\n  SELECT DISTINCT\n    user_id,\n    category\n  FROM ProductPurchases\n  JOIN ProductInfo\n    USING (product_id)\n), pair_per_user AS (\n  SELECT\n    a.user_id,\n    a.category AS category1,\n    b.category AS category2\n  FROM user_category AS a\n  JOIN user_category AS b\n    ON a.user_id = b.user_id AND a.category < b.category\n)\nSELECT\n  category1,\n  category2,\n  COUNT(DISTINCT user_id) AS customer_count\nFROM pair_per_user\nGROUP BY\n  1,\n  2\nHAVING\n  customer_count >= 3\nORDER BY\n  3 DESC,\n  1,\n  2",
