  "orderMatters": true,
  "referenceSql": "SELECT ip,COUNT(*) AS invalid_count FROM logs\nWHERE NOT (ip REGEXP '^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$')\nOR CAST(substring_index(ip,'.',1) AS INTEGER)>255\nOR CAST(substring_index(substring_index(ip,'.',2),'.',-1) AS INTEGER)>255\nOR CAST(substring_index(substring_index(ip,'.',3),'.',-1) AS INTEGER)>255\nOR CAST(substring_index(ip,'.',-1) AS INTEGER)>255\nGROUP BY ip ORDER BY invalid_count DESC,ip DESC",
