  "orderMatters": true,
  "referenceSql": "SELECT account_id,day,SUM(CASE WHEN type='Deposit' THEN amount ELSE -amount END) OVER(PARTITION BY account_id ORDER BY day ROWS UNBOUNDED PRECEDING) AS balance FROM Transactions ORDER BY account_id,day",
