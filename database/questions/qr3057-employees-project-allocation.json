  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    team,\n    AVG(workload) AS avg_workload\n  FROM Project\n  JOIN Employees\n    USING (employee_id)\n  GROUP BY\n    1\n)\nSELECT\n  employee_id,\n  project_id,\n  name AS employee_name,\n  workload AS project_workload\nFROM Project\nJOIN Employees\n  USING (employee_id)\nJOIN T\n  USING (team)\nWHERE\n  workload > avg_workload\nORDER BY\n  1,\n  2",
