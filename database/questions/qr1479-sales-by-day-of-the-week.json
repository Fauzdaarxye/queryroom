  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nSELECT\n  item_category AS category,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 2, quantity, 0)) AS Monday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 3, quantity, 0)) AS Tuesday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 4, quantity, 0)) AS Wednesday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 5, quantity, 0)) AS Thursday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 6, quantity, 0)) AS Friday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 7, quantity, 0)) AS Saturday,\n  SUM(IIF(DAY_OF_WEEK(DATE(order_date)) = 1, quantity, 0)) AS Sunday\nFROM Orders AS o\nRIGHT JOIN Items AS i\n  ON o.item_id = i.item_id\nGROUP BY\n  category\nORDER BY\n  category",
