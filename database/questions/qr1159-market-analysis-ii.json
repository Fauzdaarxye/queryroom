  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nSELECT\n  u.user_id AS seller_id,\n  CASE WHEN u.favorite_brand = i.item_brand THEN 'yes' ELSE 'no' END AS \"2nd_item_fav_brand\"\nFROM users AS u\nLEFT JOIN (\n  SELECT\n    order_date,\n    item_id,\n    seller_id,\n    RANK() OVER (PARTITION BY seller_id ORDER BY order_date) AS rk\n  FROM orders\n) AS o\n  ON u.user_id = o.seller_id AND o.rk = 2\nLEFT JOIN items AS i\n  ON o.item_id = i.item_id",
