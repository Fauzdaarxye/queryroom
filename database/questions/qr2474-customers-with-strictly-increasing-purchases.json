  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nSELECT\n  customer_id\nFROM (\n  SELECT\n    customer_id,\n    YEAR(DATE(order_date)),\n    SUM(price) AS total,\n    YEAR(DATE(order_date)) - RANK() OVER (PARTITION BY customer_id ORDER BY SUM(price)) AS rk\n  FROM Orders\n  GROUP BY\n    customer_id,\n    YEAR(DATE(order_date))\n) AS t\nGROUP BY\n  customer_id\nHAVING\n  COUNT(DISTINCT rk) = 1",
