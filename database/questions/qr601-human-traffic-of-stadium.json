  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH S AS (\n  SELECT\n    *,\n    id - (\n      ROW_NUMBER() OVER (ORDER BY id)\n    ) AS rk\n  FROM Stadium\n  WHERE\n    people >= 100\n), T AS (\n  SELECT\n    *,\n    COUNT(1) OVER (PARTITION BY rk) AS cnt\n  FROM S\n)\nSELECT\n  id,\n  visit_date,\n  people\nFROM T\nWHERE\n  cnt >= 3\nORDER BY\n  1",
