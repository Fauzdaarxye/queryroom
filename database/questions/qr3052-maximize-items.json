  "orderMatters": true,
  "referenceSql": "WITH totals AS (\n SELECT SUM(CASE WHEN item_type='prime_eligible' THEN square_footage ELSE 0 END) AS prime_area,\n SUM(item_type='prime_eligible') AS prime_count,\n SUM(CASE WHEN item_type='not_prime' THEN square_footage ELSE 0 END) AS other_area,\n SUM(item_type='not_prime') AS other_count FROM Inventory\n), batches AS (\n SELECT *,COALESCE(FLOOR(500000.0/NULLIF(prime_area,0)),0) AS prime_batches FROM totals\n)\nSELECT 'prime_eligible' AS item_type,COALESCE(prime_batches*prime_count,0) AS item_count FROM batches\nUNION ALL\nSELECT 'not_prime',COALESCE(FLOOR((500000.0-prime_batches*COALESCE(prime_area,0))/NULLIF(other_area,0))*other_count,0) FROM batches\nORDER BY item_count DESC",
