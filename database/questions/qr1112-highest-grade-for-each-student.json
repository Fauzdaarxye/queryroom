  "referenceSql": "WITH ranked AS (SELECT *,ROW_NUMBER() OVER(PARTITION BY student_id ORDER BY grade DESC,course_id) AS ranking FROM Enrollments) SELECT student_id,course_id,grade FROM ranked WHERE ranking=1 ORDER BY student_id"
