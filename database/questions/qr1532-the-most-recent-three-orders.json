  "referenceSql": "WITH ranked AS (SELECT *,ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY order_date DESC) AS ranking FROM Orders) SELECT c.name AS customer_name,c.customer_id,r.order_id,r.order_date FROM ranked r JOIN Customers c ON r.customer_id=c.customer_id WHERE ranking<=3 ORDER BY customer_name,c.customer_id,r.order_date DESC"
}
