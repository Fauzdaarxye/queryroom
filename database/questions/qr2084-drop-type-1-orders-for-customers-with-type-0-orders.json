  "referenceSql": "SELECT order_id,customer_id,order_type FROM Orders o WHERE order_type=0 OR NOT EXISTS (SELECT 1 FROM Orders preferred WHERE preferred.customer_id=o.customer_id AND preferred.order_type=0)",
