  "orderMatters": true,
  "referenceSql": "WITH RECURSIVE months(month) AS (SELECT 1 UNION ALL SELECT month+1 FROM months WHERE month<12) SELECT month,\n(SELECT COUNT(*) FROM Drivers WHERE join_date<date('2020-01-01','+'||month||' months')) AS active_drivers,\n(SELECT COUNT(*) FROM Rides JOIN AcceptedRides USING(ride_id)\n WHERE requested_at>=date('2020-01-01','+'||(month-1)||' months')\n AND requested_at<date('2020-01-01','+'||month||' months')) AS accepted_rides\nFROM months ORDER BY month",
