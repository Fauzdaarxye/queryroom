  "orderMatters": true,
  "referenceSql": "WITH daily AS (\n SELECT user_id,action_date,MIN(action) AS action FROM activity GROUP BY user_id,action_date HAVING COUNT(*)=1\n), groups AS (\n SELECT *,julianday(action_date)-row_number() OVER(PARTITION BY user_id,action ORDER BY action_date) AS grp FROM daily\n), streaks AS (\n SELECT user_id,action,COUNT(*) AS streak_length,MIN(action_date) AS start_date,MAX(action_date) AS end_date\n FROM groups GROUP BY user_id,action,grp HAVING COUNT(*)>=5\n), ranked AS (\n SELECT *,ROW_NUMBER() OVER(PARTITION BY user_id ORDER BY streak_length DESC,start_date,action) AS rn FROM streaks\n)\nSELECT user_id,action,streak_length,start_date,end_date FROM ranked WHERE rn=1 ORDER BY streak_length DESC,user_id",
