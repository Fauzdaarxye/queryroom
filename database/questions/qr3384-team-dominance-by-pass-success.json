  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    t1.team_name,\n    IIF(time_stamp <= '45:00', 1, 2) AS half_number,\n    IIF(t1.team_name = t2.team_name, 1, -1) AS dominance\n  FROM Passes AS p\n  JOIN Teams AS t1\n    ON p.pass_from = t1.player_id\n  JOIN Teams AS t2\n    ON p.pass_to = t2.player_id\n)\nSELECT\n  team_name,\n  half_number,\n  SUM(dominance) AS dominance\nFROM T\nGROUP BY\n  1,\n  2\nORDER BY\n  1,\n  2",
