  "referenceSql": "SELECT d.driver_id,COUNT(p.ride_id) AS cnt FROM (SELECT DISTINCT driver_id FROM Rides) d LEFT JOIN Rides p ON d.driver_id=p.passenger_id GROUP BY d.driver_id"
}
