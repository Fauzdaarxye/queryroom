  "orderMatters": true,
  "referenceSql": "WITH t AS (\n SELECT fail_date AS dt,'failed' AS state FROM Failed WHERE fail_date BETWEEN '2019-01-01' AND '2019-12-31'\n UNION ALL SELECT success_date,'succeeded' FROM Succeeded WHERE success_date BETWEEN '2019-01-01' AND '2019-12-31'\n), g AS (\n SELECT *, julianday(dt)-row_number() OVER(PARTITION BY state ORDER BY dt) AS grp FROM t\n)\nSELECT state AS period_state,MIN(dt) AS start_date,MAX(dt) AS end_date\nFROM g GROUP BY state,grp ORDER BY start_date",
