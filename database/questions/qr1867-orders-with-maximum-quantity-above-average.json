  "referenceSql": "WITH quantities AS (SELECT order_id,MAX(quantity) AS maximum,AVG(quantity*1.0) AS average FROM OrdersDetails GROUP BY order_id) SELECT order_id FROM quantities WHERE maximum>(SELECT MAX(average) FROM quantities)"
}
