  "orderMatters": false,
  "referenceSql": "WITH RECURSIVE letters(content_id,original_text,pos,converted_text) AS (\n SELECT content_id,content_text,1,'' FROM user_content\n UNION ALL\n SELECT content_id,original_text,pos+1,converted_text ||\n CASE WHEN pos=1 OR substr(original_text,pos-1,1)=' ' THEN upper(substr(original_text,pos,1)) ELSE lower(substr(original_text,pos,1)) END\n FROM letters WHERE pos<=length(original_text)\n)\nSELECT content_id,original_text,converted_text FROM letters WHERE pos=length(original_text)+1",
