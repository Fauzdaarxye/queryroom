  "orderMatters": true,
  "referenceSql": "WITH RECURSIVE T AS (\n  SELECT\n    '2023-11-01' AS purchase_date\n  UNION\n  SELECT\n    date(purchase_date,'+1 day')\n  FROM T\n  WHERE\n    purchase_date < '2023-11-30'\n)\nSELECT\n  CEIL(CAST(DAY_OF_MONTH(DATE(purchase_date)) AS REAL) / 7) AS week_of_month,\n  purchase_date,\n  COALESCE(SUM(amount_spend), 0) AS total_amount\nFROM T\nLEFT JOIN Purchases\n  USING (purchase_date)\nWHERE\n  DAY_OF_WEEK(DATE(purchase_date)) = 6\nGROUP BY\n  2\nORDER BY\n  1",
