  "orderMatters": true,
  "referenceSql": "WITH T AS (\n  SELECT DISTINCT\n    employee_id,\n    start_time AS st\n  FROM EmployeeShifts\n  UNION\n  SELECT DISTINCT\n    employee_id,\n    end_time AS st\n  FROM EmployeeShifts\n), P AS (\n  SELECT\n    *,\n    LEAD(st) OVER (PARTITION BY employee_id ORDER BY st) AS ed\n  FROM T\n), S AS (\n  SELECT\n    P.*,\n    COUNT(1) AS concurrent_count\n  FROM P\n  INNER JOIN EmployeeShifts\n    USING (employee_id)\n  WHERE\n    P.st >= EmployeeShifts.start_time AND P.ed <= EmployeeShifts.end_time\n  GROUP BY\n    1,\n    2,\n    3\n), U AS (\n  SELECT\n    t1.employee_id,\n    SUM(CAST((unixepoch(MIN(t1.end_time,t2.end_time))-unixepoch(t2.start_time))/60 AS INTEGER)) AS total_overlap_duration\n  FROM EmployeeShifts AS t1\n  JOIN EmployeeShifts AS t2\n    ON t1.employee_id = t2.employee_id\n    AND date(t1.start_time)=date(t2.start_time) AND t1.start_time < t2.start_time\n    AND t1.end_time > t2.start_time\n  GROUP BY\n    1\n)\nSELECT\n  employee_id,\n  MAX(concurrent_count) AS max_overlapping_shifts,\n  COALESCE(AVG(total_overlap_duration), 0) AS total_overlap_duration\nFROM S\nLEFT JOIN U\n  USING (employee_id)\nGROUP BY\n  1\nORDER BY\n  1",
