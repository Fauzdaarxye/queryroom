  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    country,\n    winery || ' (' || points || ')' AS winery,\n    RANK() OVER (PARTITION BY country ORDER BY points DESC, winery) AS rk\n  FROM (\n    SELECT\n      country,\n      SUM(points) AS points,\n      winery\n    FROM Wineries\n    GROUP BY\n      1,\n      3\n  ) AS t\n)\nSELECT\n  t1.country,\n  t1.winery AS top_winery,\n  COALESCE(t2.winery, 'No second winery') AS second_winery,\n  COALESCE(t3.winery, 'No third winery') AS third_winery\nFROM T AS t1\nLEFT JOIN T AS t2\n  ON t1.country = t2.country AND t1.rk = t2.rk - 1\nLEFT JOIN T AS t3\n  ON t2.country = t3.country AND t2.rk = t3.rk - 1\nWHERE\n  t1.rk = 1\nORDER BY\n  1",
