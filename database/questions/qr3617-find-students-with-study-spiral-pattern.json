  "orderMatters": true,
  "referenceSql": "WITH ordered AS (\n SELECT *,LAG(session_date) OVER(PARTITION BY student_id ORDER BY session_date,session_id) AS previous_date FROM study_sessions\n), grouped AS (\n SELECT *,SUM(CASE WHEN previous_date IS NULL OR julianday(session_date)-julianday(previous_date)>2 THEN 1 ELSE 0 END)\n OVER(PARTITION BY student_id ORDER BY session_date,session_id) AS grp FROM ordered\n), positions AS (\n SELECT *,ROW_NUMBER() OVER(PARTITION BY student_id,grp ORDER BY session_date,session_id) AS rn FROM grouped\n), summaries AS (\n SELECT student_id,grp,COUNT(DISTINCT subject) AS cycle_length,COUNT(*) AS n,SUM(hours_studied) AS hours FROM positions GROUP BY student_id,grp\n), valid AS (\n SELECT *,ROW_NUMBER() OVER(PARTITION BY student_id ORDER BY cycle_length DESC,hours DESC,grp) AS choice FROM summaries g\n WHERE cycle_length>=3 AND n>=2*cycle_length AND NOT EXISTS (\n SELECT 1 FROM positions a JOIN positions b ON a.student_id=b.student_id AND a.grp=b.grp\n AND b.rn=((a.rn-1)%g.cycle_length)+1\n WHERE a.student_id=g.student_id AND a.grp=g.grp AND a.subject<>b.subject\n )\n)\nSELECT s.student_id,s.student_name,s.major,v.cycle_length,v.hours AS total_study_hours\nFROM valid v JOIN students s USING(student_id) WHERE choice=1 ORDER BY cycle_length DESC,total_study_hours DESC",
