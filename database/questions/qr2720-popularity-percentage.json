  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH F AS (\n  SELECT\n    *\n  FROM Friends\n  UNION\n  SELECT\n    user2,\n    user1\n  FROM Friends\n), T AS (\n  SELECT\n    COUNT(DISTINCT user1) AS cnt\n  FROM F\n)\nSELECT DISTINCT\n  user1,\n  ROUND(\n    CAST((\n      COUNT(1) OVER (PARTITION BY user1)\n    ) * 100 AS REAL) / (\n      SELECT\n        cnt\n      FROM T\n    ),\n    2\n  ) AS percentage_popularity\nFROM F\nORDER BY\n  1",
