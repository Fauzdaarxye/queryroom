  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    *,\n    ROW_NUMBER() OVER (PARTITION BY continent ORDER BY name) AS rk\n  FROM Student\n)\nSELECT\n  MAX(IIF(continent = 'America', name, NULL)) AS \"America\",\n  MAX(IIF(continent = 'Asia', name, NULL)) AS \"Asia\",\n  MAX(IIF(continent = 'Europe', name, NULL)) AS \"Europe\"\nFROM T\nGROUP BY\n  rk",
