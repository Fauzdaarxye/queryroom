  "referenceSql": "WITH ranked AS (SELECT transaction_id,DENSE_RANK() OVER(PARTITION BY DATE(day) ORDER BY amount DESC) AS ranking FROM Transactions) SELECT transaction_id FROM ranked WHERE ranking=1 ORDER BY transaction_id"
