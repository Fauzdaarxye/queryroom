  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH S AS (\n  SELECT\n    hall_id,\n    start_day,\n    end_day,\n    MAX(end_day) OVER (PARTITION BY hall_id ORDER BY start_day) AS cur_max_end_day\n  FROM HallEvents\n), T AS (\n  SELECT\n    *,\n    IIF(\n      start_day <= LAG(cur_max_end_day) OVER (PARTITION BY hall_id ORDER BY start_day),\n      0,\n      1\n    ) AS start\n  FROM S\n), P AS (\n  SELECT\n    *,\n    SUM(start) OVER (PARTITION BY hall_id ORDER BY start_day) AS gid\n  FROM T\n)\nSELECT\n  hall_id,\n  MIN(start_day) AS start_day,\n  MAX(end_day) AS end_day\nFROM P\nGROUP BY\n  hall_id,\n  gid",
