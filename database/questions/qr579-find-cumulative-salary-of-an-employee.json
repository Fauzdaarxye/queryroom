  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nSELECT\n  id,\n  month,\n  SUM(salary) OVER (PARTITION BY id ORDER BY month RANGE BETWEEN 2 PRECEDING AND CURRENT ROW) AS Salary\nFROM employee\nWHERE\n  NOT (id, month) IN (\n    SELECT\n      id,\n      MAX(month)\n    FROM Employee\n    GROUP BY\n      id\n  )\nORDER BY\n  id,\n  month DESC",
