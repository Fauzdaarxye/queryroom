  "referenceSql": "WITH weights AS (SELECT person_name,turn,SUM(weight) OVER(ORDER BY turn ROWS UNBOUNDED PRECEDING) AS total FROM Queue) SELECT person_name FROM weights WHERE total<=1000 ORDER BY turn DESC LIMIT 1"
}
