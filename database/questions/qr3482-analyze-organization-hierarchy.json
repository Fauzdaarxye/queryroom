  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH RECURSIVE level_cte AS (\n  SELECT\n    employee_id,\n    manager_id,\n    1 AS level,\n    salary\n  FROM Employees\n  UNION ALL\n  SELECT\n    a.employee_id,\n    b.manager_id,\n    level + 1,\n    a.salary\n  FROM level_cte AS a\n  JOIN Employees AS b\n    ON b.employee_id = a.manager_id\n), employee_with_level AS (\n  SELECT\n    a.employee_id,\n    a.employee_name,\n    a.salary,\n    b.level\n  FROM Employees AS a, (\n    SELECT\n      employee_id,\n      level\n    FROM level_cte\n    WHERE\n      manager_id IS NULL\n  ) AS b\n  WHERE\n    a.employee_id = b.employee_id\n)\nSELECT\n  a.employee_id,\n  a.employee_name,\n  a.level,\n  COALESCE(b.team_size, 0) AS team_size,\n  a.salary + COALESCE(b.budget, 0) AS budget\nFROM employee_with_level AS a\nLEFT JOIN (\n  SELECT\n    manager_id AS employee_id,\n    COUNT(*) AS team_size,\n    SUM(salary) AS budget\n  FROM level_cte\n  WHERE\n    NOT manager_id IS NULL\n  GROUP BY\n    manager_id\n) AS b\n  ON a.employee_id = b.employee_id\nORDER BY\n  level,\n  budget DESC,\n  employee_name",
