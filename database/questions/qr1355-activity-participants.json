  "referenceSql": "WITH counts AS (SELECT activity,COUNT(*) AS total FROM Friends GROUP BY activity) SELECT activity FROM counts WHERE total>(SELECT MIN(total) FROM counts) AND total<(SELECT MAX(total) FROM counts)"
