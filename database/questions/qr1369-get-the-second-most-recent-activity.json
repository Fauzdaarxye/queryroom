  "orderMatters": false,
  "referenceSql": "SELECT\n  username,\n  activity,\n  startdate,\n  enddate\nFROM (\n  SELECT\n    *,\n    RANK() OVER (PARTITION BY username ORDER BY startdate DESC) AS rk,\n    COUNT(username) OVER (PARTITION BY username) AS cnt\n  FROM UserActivity\n) AS a\nWHERE\n  a.rk = 2 OR a.cnt = 1",
