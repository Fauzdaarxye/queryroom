  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH RECURSIVE T AS (\n  SELECT\n    employee_id,\n    employee_name,\n    0 AS hierarchy_level,\n    manager_id,\n    salary\n  FROM Employees\n  WHERE\n    manager_id IS NULL\n  UNION ALL\n  SELECT\n    e.employee_id,\n    e.employee_name,\n    hierarchy_level + 1 AS hierarchy_level,\n    e.manager_id,\n    e.salary\n  FROM T AS t\n  JOIN Employees AS e\n    ON t.employee_id = e.manager_id\n), P AS (\n  SELECT\n    salary\n  FROM Employees\n  WHERE\n    manager_id IS NULL\n)\nSELECT\n  employee_id AS subordinate_id,\n  employee_name AS subordinate_name,\n  hierarchy_level,\n  t.salary - p.salary AS salary_difference\nFROM T AS t, P AS p\nWHERE\n  hierarchy_level <> 0\nORDER BY\n  3,\n  1",
