  "orderMatters": true,
  "referenceSql": "WITH days AS (SELECT DISTINCT customer_id,transaction_date FROM Transactions), g AS (\n SELECT *,julianday(transaction_date)-row_number() OVER(PARTITION BY customer_id ORDER BY transaction_date) AS grp FROM days\n), streaks AS (SELECT customer_id,COUNT(*) AS n FROM g GROUP BY customer_id,grp)\nSELECT DISTINCT customer_id FROM streaks WHERE n=(SELECT MAX(n) FROM streaks) ORDER BY customer_id",
