  "orderMatters": true,
  "referenceSql": "WITH RECURSIVE months(month) AS (SELECT 1 UNION ALL SELECT month+1 FROM months WHERE month<12), monthly AS (\n SELECT month,COALESCE(SUM(ride_distance),0) AS distance,COALESCE(SUM(ride_duration),0) AS duration\n FROM months LEFT JOIN Rides ON requested_at>=date('2020-01-01','+'||(month-1)||' months')\n AND requested_at<date('2020-01-01','+'||month||' months')\n LEFT JOIN AcceptedRides USING(ride_id) GROUP BY month\n), averages AS (\n SELECT month,ROUND(AVG(distance) OVER(ORDER BY month ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING),2) AS average_ride_distance,\n ROUND(AVG(duration) OVER(ORDER BY month ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING),2) AS average_ride_duration FROM monthly\n)\nSELECT * FROM averages WHERE month<=10 ORDER BY month",
