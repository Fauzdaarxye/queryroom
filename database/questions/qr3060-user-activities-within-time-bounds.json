  "orderMatters": true,
  "referenceSql": "SELECT DISTINCT a.user_id FROM Sessions a JOIN Sessions b\nON a.user_id=b.user_id AND a.session_type=b.session_type AND a.session_id<>b.session_id\nWHERE b.session_start>=a.session_end\nAND unixepoch(b.session_start)-unixepoch(a.session_end)<=43200 ORDER BY a.user_id",
