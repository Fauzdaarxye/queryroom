  "orderMatters": false,
  "referenceSql": "WITH RECURSIVE reports AS (SELECT employee_id FROM Employees WHERE manager_id=1 AND employee_id<>1 UNION ALL SELECT e.employee_id FROM Employees e JOIN reports r ON e.manager_id=r.employee_id WHERE e.employee_id<>1) SELECT employee_id FROM reports",
