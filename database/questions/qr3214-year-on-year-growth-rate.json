  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH T AS (\n  SELECT\n    product_id,\n    YEAR(DATE(transaction_date)) AS year,\n    SUM(spend) AS curr_year_spend\n  FROM user_transactions\n  GROUP BY\n    1,\n    2\n), S AS (\n  SELECT\n    t1.year,\n    t1.product_id,\n    t1.curr_year_spend,\n    t2.curr_year_spend AS prev_year_spend\n  FROM T AS t1\n  LEFT JOIN T AS t2\n    ON t1.product_id = t2.product_id AND t1.year = t2.year + 1\n)\nSELECT\n  *,\n  ROUND(CAST((\n    curr_year_spend - prev_year_spend\n  ) AS REAL) / prev_year_spend * 100, 2) AS yoy_rate\nFROM S\nORDER BY\n  2,\n  1",
