  "orderMatters": false,
  "referenceSql": "/* Write your MySQL query statement below */\nWITH s AS (\n  SELECT\n    *\n  FROM Calls\n  UNION ALL\n  SELECT\n    recipient_id,\n    caller_id,\n    call_time\n  FROM Calls\n), t AS (\n  SELECT\n    caller_id AS user_id,\n    FIRST_VALUE(recipient_id) OVER (PARTITION BY STRFTIME('%Y-%m-%d', call_time), caller_id ORDER BY call_time ASC) AS first,\n    FIRST_VALUE(recipient_id) OVER (PARTITION BY STRFTIME('%Y-%m-%d', call_time), caller_id ORDER BY call_time DESC) AS last\n  FROM s\n)\nSELECT DISTINCT\n  user_id\nFROM t\nWHERE\n  first = last",
