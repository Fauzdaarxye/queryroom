  "orderMatters": true,
  "referenceSql": "/* Write your MySQL query statement below */\nSELECT\n  passenger_id,\n  IIF(\n    (\n      RANK() OVER (PARTITION BY flight_id ORDER BY booking_time)\n    ) <= capacity,\n    'Confirmed',\n    'Waitlist'\n  ) AS Status\nFROM Passengers\nJOIN Flights\n  USING (flight_id)\nORDER BY\n  passenger_id",
