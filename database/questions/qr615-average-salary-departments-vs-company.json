  "orderMatters": false,
  "referenceSql": "WITH t AS (\n SELECT strftime('%Y-%m',pay_date) AS pay_month, department_id, amount\n FROM Salary JOIN Employee USING(employee_id)\n), a AS (\n SELECT *, AVG(amount) OVER(PARTITION BY pay_month) AS company_avg,\n AVG(amount) OVER(PARTITION BY pay_month,department_id) AS dept_avg FROM t\n)\nSELECT DISTINCT pay_month, department_id,\n CASE WHEN dept_avg>company_avg THEN 'higher' WHEN dept_avg<company_avg THEN 'lower' ELSE 'same' END AS comparison FROM a",
