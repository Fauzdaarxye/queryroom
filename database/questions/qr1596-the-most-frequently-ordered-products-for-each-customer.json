  "orderMatters": false,
  "referenceSql": "WITH counts AS (SELECT customer_id,product_id,COUNT(*) AS frequency FROM Orders GROUP BY customer_id,product_id), ranked AS (SELECT *,DENSE_RANK() OVER(PARTITION BY customer_id ORDER BY frequency DESC) AS ranking FROM counts) SELECT r.customer_id,r.product_id,p.product_name FROM ranked r JOIN Products p ON r.product_id=p.product_id WHERE ranking=1",
