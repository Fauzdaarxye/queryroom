# Optional. Docker Compose works without this file.
# :80 works over HTTP using the EC2 IP. Set a domain for automatic HTTPS:
# CADDY_SITE=queryroom.example.com
CADDY_SITE=:80

# Used only when the credentials volume is initialized for the first time.
# Leave blank to generate separate random passwords automatically.
MYSQL_PASSWORD=
POSTGRES_PASSWORD=

# Optional Google sign-in. Guests can practise without it.
# Create a Web application OAuth client in Google Auth Platform.
GOOGLE_CLIENT_ID=992227236229-ec3g0vp18kuajbjv6dumlilld5ljtcpq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Local npm run dev defaults to http://localhost:4317/api/auth/google/callback.
# Docker Compose defaults to https://queryroom.duckdns.org/api/auth/google/callback.
# Set this only if your deployment address is different:
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
