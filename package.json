{
  "name": "queryroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SQL practice with Next.js, TypeScript, PostgreSQL, and a reviewed question catalog.",
  "scripts": {
    "dev": "tsx backend/index.ts --dev",
    "start": "tsx backend/index.ts",
    "build": "next build frontend --webpack",
    "test": "npm run build && node --import tsx scripts/test.mjs",
    "leaderboard:backfill": "tsx scripts/backfill-leaderboard.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.39.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.24.4",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "prettier": "^3.9.7"
  }
}
